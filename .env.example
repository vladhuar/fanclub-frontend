# URL pública del backend (sin barra final).
VITE_API_URL=https://p01--fanclub--kdvgxykq2qs6.code.run

# Para trabajar contra un backend local, comentá la línea anterior y usá:
# VITE_API_URL=http://localhost:8080

# --- Hero animado (opcional) ---
# Colocá el archivo en public/hero/ y usá una ruta absoluta.
# Si se omite, el hero usa una animación CSS de respaldo.
#
# Mini-video liviano (recomendado, 3-6 MB, sin audio):
# VITE_HERO_MEDIA_URL=/hero/hero.webm
# VITE_HERO_MEDIA_TYPE=video
# VITE_HERO_POSTER_URL=/hero/hero-poster.jpg
#
# GIF o imagen (hasta ~5 MB para no demorar la primera carga):
# VITE_HERO_MEDIA_URL=/hero/hero.gif
# VITE_HERO_MEDIA_TYPE=image
